# Copy to .env (which is gitignored) and fill with real values from your secret manager.
# No real secrets are committed to the repository.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=appdb
JWT_SECRET=            # >= 32 random chars, e.g. `openssl rand -base64 48`
COOKIE_SECRET=         # >= 32 random chars
ALLOWED_FETCH_HOSTS=api.example.com,cdn.example.com
